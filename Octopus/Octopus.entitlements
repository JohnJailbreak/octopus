<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Signed into Octopus.app by tools/package.sh, as in Caz and Speaka. Outside the sandbox, Octopus can save a
	     downloaded update where the root helper takes it (Updater.downloadFolders) and start that helper, as root,
	     with persona-mgmt (Octopus/App/Spawn/oct_spawn.c). -->
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>platform-application</key>
	<true/>
</dict>
</plist>
